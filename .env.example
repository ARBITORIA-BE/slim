# Slim — 환경 변수 (실제 값은 .env.local에)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""

# Inngest (1.6 cron) - prod 배포에서 검증 필수
# dev: npx inngest-cli@latest dev (키 없이 동작)
# prod: app.inngest.com -> Settings -> Keys
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# 1.5.5 가드 - DB 인스턴스 일치 검증
# Neon Console에서 production 브랜치 endpoint 복사 (예: ep-xxx-yyy-zzz)
# verify:db가 실제 host와 비교, 불일치 시 stop-gate 차단
EXPECTED_DB_ENDPOINT=""
