# ───────────────────────────────────────────────────────────────────────────
# .env.local.example — 로컬 개발용 환경변수 템플릿  (ADR-0022: DB 환경 분리)
#
# 사용법: 이 파일을 `.env.local` 로 복사하고 값을 채운다. `.env.local` 은
# `.gitignore` 대상 — 절대 커밋하지 않는다.
#
# ⚠️ ADR-0022 D2: production connection string(비번 포함)은 *어디에도* 영속
#    저장하지 않는다 — `.env.local` 포함. 로컬 기본값은 항상 `development`
#    브랜치. production 작업이 필요하면 그때그때 인라인 명령으로만 (아래 D4 메모).
# ───────────────────────────────────────────────────────────────────────────

# ── DB ──────────────────────────────────────────────────────────────────────
# 로컬 기본값 = Neon `development` 브랜치 (ADR-0022 D1).
# 운영자가 Neon Console → Slim → Branches → `development` → Connection details
# 에서 복사. `pnpm dev` / `pnpm test` / `pnpm db:push` 는 항상 이 브랜치만 만진다.
DATABASE_URL="postgres://USER:PASSWORD@ep-dev-XXXX-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Endpoint allowlist 가드 (ADR-0022 D3 — scripts/verify-db.ts).
# 콤마 구분. 로컬에서는 3 endpoint 모두 허용: production / preview / development.
#   - ep-fancy-fog-alt18340      → production (인라인으로 잠깐 가리켜도 통과)
#   - ep-autumn-water-all6d93e   → preview   (Vercel preview 빌드 전용)
#   - ep-dev-XXXX                → development (← 운영자가 실제 name 으로 교체)
# Vercel production env 에서는 단일(ep-fancy-fog-alt18340), preview env 에서는
# 단일(ep-autumn-water-all6d93e) 로 설정 — D.4.e.
EXPECTED_DB_ENDPOINTS="ep-fancy-fog-alt18340,ep-autumn-water-all6d93e,ep-dev-XXXX"

# ── Inngest (데이터 수집 cron) ──────────────────────────────────────────────
# Inngest 대시보드 → Manage → Keys. production/preview 양쪽 Vercel env 에도 등록(D.3.c).
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ───────────────────────────────────────────────────────────────────────────
# production 작업 메모 (ADR-0022 D4) — `.env.local` 을 건드리지 않는다:
#
#   PowerShell:
#     $env:DATABASE_URL = "postgres://...prod string from Neon Console..."
#     pnpm db:push
#     Remove-Item Env:\DATABASE_URL    # 끝나면 즉시 정리
#
#   bash:
#     DATABASE_URL="postgres://...prod..." pnpm db:push
#
# dotenv 는 이미 존재하는 환경변수를 덮지 않으므로(override:false) 인라인 값이
# `.env.local` 보다 우선한다 — 의도된 동작.
# ───────────────────────────────────────────────────────────────────────────
